{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": { "analytics": false },
  "projects": {
    "shell": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/shell",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json"
          },
          "configurations": {
            "demo": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                { "glob": "**/*", "input": "public" },
                { "glob": "**/*", "input": "portals", "output": "portals" }
              ]
            },
            "production": {
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": true },
              "assets": [{ "glob": "**/*", "input": "public" }],
              "fileReplacements": [
                { "replace": "src/app/core/auth/dev-routes.ts", "with": "src/app/core/auth/dev-routes.production.ts" }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "assets": [
                { "glob": "federation.manifest.json", "input": "e2e/manifest" },
                { "glob": "*.js", "input": "e2e/stubs", "output": "stubs" }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": { "buildTarget": "shell:build:development" },
            "demo": { "buildTarget": "shell:build:demo" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": { "tsConfig": "tsconfig.spec.json", "runner": "vitest", "buildTarget": "::development" }
        }
      }
    }
  }
}
